{
  "manifest_version": 3,
  "name": "تحلیل تماس فراز هنر",
  "description": "تحلیل هوشمند مکالمات ضبط‌شده‌ی فروشندگان از پنل تلفنی",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://192.168.139.15/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://192.168.139.15/index.php*"
      ],
      "js": [
        "src/lib/parser.js",
        "src/lib/settings.js",
        "src/lib/queue.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_page": "src/options.html",
  "action": {
    "default_title": "تحلیل تماس"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}