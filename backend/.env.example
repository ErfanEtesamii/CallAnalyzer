# توکن دسترسی اکستنشن به بک‌اند (حتماً مقدار تصادفی بلند بگذارید)
API_TOKEN=
# مبدأهای مجاز CORS، مثلاً chrome-extension://<ID>
ALLOWED_ORIGINS=
# مدل تحلیل: anthropic (پولی، دقیق‌تر) یا gemini (رایگان با سهمیه؛ در حالت رایگان Google ممکن است محتوا را برای بهبود محصولاتش استفاده کند)
LLM_PROVIDER=anthropic
# کلید Anthropic (فقط سمت سرور)
ANTHROPIC_API_KEY=
# کلید Gemini از https://aistudio.google.com/apikey (وقتی LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# اختیاری: برای مدل‌های 2.5 می‌توان thinking را خاموش کرد (۰) تا توکن خروجی کمتر مصرف شود
GEMINI_THINKING_BUDGET=
# نام مدل تحلیل. خالی = پیش‌فرض هر ارائه‌دهنده (claude-sonnet-5-5 / gemini-2.5-flash). نام Gemini را در AI Studio تطبیق دهید
ANALYSIS_MODEL=
# mock | openai | groq (رایگان با سهمیه) | faster_whisper | custom_http
STT_PROVIDER=mock
OPENAI_API_KEY=
# کلید Groq از https://console.groq.com/keys (وقتی STT_PROVIDER=groq)
GROQ_API_KEY=
# اختیاری: نام مدل STT (پیش‌فرض groq: whisper-large-v3 ، openai: whisper-1)
STT_MODEL=
# توکن Hugging Face برای pyannote
HF_TOKEN=
# حداقل مدت تماس قابل‌تحلیل (ثانیه)
MIN_CALL_SECONDS=20
# حداقل نسبت گفتار؛ کمتر از آن «بدون مکالمه»
MIN_SPEECH_RATIO=0.15
MAX_UPLOAD_MB=25
# ۰ = حذف فایل صوتی بعد از پردازش
RETENTION_AUDIO_DAYS=0
RETENTION_DATA_DAYS=180
# مخفی‌سازی شماره‌کارت/کد ملی/تلفن پیش از ارسال به Claude
REDACT_PII=true
DAILY_BUDGET_USD=10
DATABASE_URL=sqlite:///./data/app.db
STORAGE_DIR=./data/storage
LOG_LEVEL=INFO

# پوشه‌ی اکستنشن که بک‌اند برای همگام‌سازی خودکار کامپیوترها سرو می‌کند
EXTENSION_DIR=../extension
