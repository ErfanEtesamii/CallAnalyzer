# توکن دسترسی اکستنشن به بک‌اند (حتماً مقدار تصادفی بلند بگذارید)
API_TOKEN=
# مبدأهای مجاز CORS، مثلاً chrome-extension://<ID>
ALLOWED_ORIGINS=
# کلید Anthropic (فقط سمت سرور)
ANTHROPIC_API_KEY=
# نام مدل تحلیل؛ پیش از استقرار با مستندات Anthropic تطبیق دهید
ANALYSIS_MODEL=claude-sonnet-5-5
# mock | openai | faster_whisper | custom_http
STT_PROVIDER=mock
OPENAI_API_KEY=
# توکن Hugging Face برای pyannote
HF_TOKEN=
# حداقل مدت تماس قابل‌تحلیل (ثانیه)
MIN_CALL_SECONDS=20
# حداقل نسبت گفتار؛ کمتر از آن «بدون مکالمه»
MIN_SPEECH_RATIO=0.15
MAX_UPLOAD_MB=25
# ۰ = حذف فایل صوتی بعد از پردازش
RETENTION_AUDIO_DAYS=0
RETENTION_DATA_DAYS=180
# مخفی‌سازی شماره‌کارت/کد ملی/تلفن پیش از ارسال به Claude
REDACT_PII=true
DAILY_BUDGET_USD=10
DATABASE_URL=sqlite:///./data/app.db
STORAGE_DIR=./data/storage
LOG_LEVEL=INFO

# پوشه‌ی اکستنشن که بک‌اند برای همگام‌سازی خودکار کامپیوترها سرو می‌کند
EXTENSION_DIR=../extension
